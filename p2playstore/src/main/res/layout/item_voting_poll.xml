<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Update Title -->
        <TextView
            android:id="@+id/update_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latest Update v1.2.3"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Voting Question -->
        <TextView
            android:id="@+id/voting_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Does this update work correctly and appear safe?"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Votes Required -->
        <TextView
            android:id="@+id/votes_required_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3 of 5 votes needed"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal" />

        <!-- Yes Vote Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="Yes"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E0E0E0" />

                <View
                    android:id="@+id/yes_progress_bar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="#4CAF50" />

            </FrameLayout>

            <TextView
                android:id="@+id/yes_percentage"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="75%"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <!-- No Vote Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="No"
                android:textColor="#F44336"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E0E0E0" />

                <View
                    android:id="@+id/no_progress_bar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="#F44336" />

            </FrameLayout>

            <TextView
                android:id="@+id/no_percentage"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="15%"
                android:textColor="#F44336"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <!-- Pending Vote Progress -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E0E0E0" />

                <View
                    android:id="@+id/pending_progress_bar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="#9E9E9E" />

            </FrameLayout>

            <TextView
                android:id="@+id/pending_percentage"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="10%"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="end" />
        </LinearLayout>

        <!-- Vote Summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/total_votes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="8 of 10 members voted"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/voting_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active"
                android:textColor="#1E88E5"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
