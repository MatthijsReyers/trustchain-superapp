<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@android:color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Implementation Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/original_feature_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Dark Mode Support"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/implementation_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Added dark theme toggle in settings with automatic switching based on system preference."
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Developer: "
                            android:textSize="12sp"
                            android:textColor="#999" />

                        <TextView
                            android:id="@+id/developer_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="abc123..."
                            android:textSize="12sp"
                            android:textColor="#666" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reward: "
                            android:textSize="12sp"
                            android:textColor="#999" />

                        <TextView
                            android:id="@+id/reward_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10000 sats"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#4CAF50" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- APK Download Button -->
            <Button
                android:id="@+id/btn_download_apk"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#1976D2"
                android:text="Download APK to Test"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <!-- Voting Question -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Are you in fact sure this is the page?"
                android:textColor="#333"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test the APK and vote"
                android:textSize="14sp"
                android:textColor="#666"
                android:layout_marginBottom="24dp" />

            <!-- Voting Progress Options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <!-- Yes Option - Progress Bar Style -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Yes"
                            android:textSize="16sp"
                            android:textColor="#333" />

                        <TextView
                            android:id="@+id/percentage_yes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="75%"
                            android:textSize="16sp"
                            android:textColor="#4CAF50"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/yes_progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_gravity="center_vertical"
                            android:background="#EEEEEE" />

                        <View
                            android:id="@+id/yes_progress"
                            android:layout_width="100dp"
                            android:layout_height="8dp"
                            android:layout_gravity="center_vertical"
                            android:background="#4CAF50" />

                    </FrameLayout>

                </LinearLayout>

                <!-- No Option - Progress Bar Style -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No"
                            android:textSize="16sp"
                            android:textColor="#333" />

                        <TextView
                            android:id="@+id/percentage_no"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20%"
                            android:textSize="16sp"
                            android:textColor="#F44336"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/no_progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_gravity="center_vertical"
                            android:background="#EEEEEE" />

                        <View
                            android:id="@+id/no_progress"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_gravity="center_vertical"
                            android:background="#F44336" />

                    </FrameLayout>

                </LinearLayout>

                <!-- Pending Option - Progress Bar Style -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Pending"
                            android:textSize="16sp"
                            android:textColor="#333" />

                        <TextView
                            android:id="@+id/percentage_pending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5%"
                            android:textSize="16sp"
                            android:textColor="#9E9E9E"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/pending_progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_gravity="center_vertical"
                            android:background="#EEEEEE" />

                        <View
                            android:id="@+id/pending_progress"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_gravity="center_vertical"
                            android:background="#9E9E9E" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Vote Buttons -->
            <LinearLayout
                android:id="@+id/voting_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:visibility="visible">

                <Button
                    android:id="@+id/btn_vote_yes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Vote Yes"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#4CAF50"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_vote_no"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Vote No"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#F44336"
                    android:layout_marginStart="8dp" />

            </LinearLayout>
            <!-- Claim Reward Button (Hidden by default) -->
            <Button
                android:id="@+id/btn_claim_reward"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Claim Reward"
                android:textColor="@android:color/white"
                android:backgroundTint="#007BFF"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />


            <!-- Vote Status -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F8F9FA">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/votes_required_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3 of 5 votes needed for approval"
                        android:textSize="14sp"
                        android:textColor="#666"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/already_voted_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✓ You have already voted"
                        android:textSize="14sp"
                        android:textColor="#4CAF50"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
